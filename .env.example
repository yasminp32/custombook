DJANGO_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local Postgres
DB_NAME=techgeum_book
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Render uses this instead of DB_NAME / DB_USER / DB_PASSWORD
# DATABASE_URL=postgres://user:password@host:5432/dbname

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Use smtp.EmailBackend for real emails, console.EmailBackend for terminal-only testing
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

OTP_EXPIRY_MINUTES=10
# True on Render free plan so register can login without email OTP
SKIP_EMAIL_OTP=False
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
