{
  "info": {
    "name": "Techgeum Projects",
    "description": "Run in order: 0 Login → 1 Form → 2 Create. Tabs and status filters are GET only. Create is POST /api/projects/ with JSON name and customer_id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "access_token", "value": "" },
    { "key": "customer_id", "value": "" },
    { "key": "project_id", "value": "" },
    { "key": "active_project_id", "value": "" },
    { "key": "complete_project_id", "value": "" },
    { "key": "hold_project_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "0. Login",
      "item": [
        {
          "name": "Login — saves access_token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json.access || (json.data && json.data.access);",
                  "if (token) { pm.collectionVariables.set('access_token', token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your@email.com\",\n  \"password\": \"YourPassword\"\n}"
            },
            "url": "{{base_url}}/api/accounts/login/"
          }
        }
      ]
    },
    {
      "name": "1. Form and options",
      "item": [
        {
          "name": "Form — saves customer_id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json.data || {};",
                  "if (data.customers && data.customers.length) {",
                  "  pm.collectionVariables.set('customer_id', data.customers[0].customer_id);",
                  "}"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{base_url}}/api/projects/form/" }
        },
        {
          "name": "Options",
          "request": { "method": "GET", "url": "{{base_url}}/api/projects/options/" }
        }
      ]
    },
    {
      "name": "2. Create",
      "item": [
        {
          "name": "Website Redesign — project hours ACTIVE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.project_id) {",
                  "  pm.collectionVariables.set('active_project_id', json.data.project_id);",
                  "  pm.collectionVariables.set('project_id', json.data.project_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Website Redesign\",\n  \"customer_id\": \"{{customer_id}}\",\n  \"billing_method\": \"project_hours\",\n  \"rate\": \"150.00\",\n  \"budget_hours\": \"42\"\n}"
            },
            "url": "{{base_url}}/api/projects/"
          }
        },
        {
          "name": "Mobile App Development — staff hours ACTIVE",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mobile App Development\",\n  \"customer_id\": \"{{customer_id}}\",\n  \"billing_method\": \"staff_hours\",\n  \"rate\": \"200.00\",\n  \"budget_hours\": \"95\"\n}"
            },
            "url": "{{base_url}}/api/projects/"
          }
        },
        {
          "name": "Brand Identity — fixed cost then complete",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.project_id) {",
                  "  pm.collectionVariables.set('complete_project_id', json.data.project_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Brand Identity\",\n  \"customer_id\": \"{{customer_id}}\",\n  \"billing_method\": \"fixed_cost\",\n  \"rate\": \"5000.00\",\n  \"budget_hours\": \"0\"\n}"
            },
            "url": "{{base_url}}/api/projects/"
          }
        },
        {
          "name": "SEO Audit — task hours then on hold",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.project_id) {",
                  "  pm.collectionVariables.set('hold_project_id', json.data.project_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SEO Audit\",\n  \"customer_id\": \"{{customer_id}}\",\n  \"billing_method\": \"task_hours\",\n  \"rate\": \"120.00\",\n  \"budget_hours\": \"12\"\n}"
            },
            "url": "{{base_url}}/api/projects/"
          }
        }
      ]
    },
    {
      "name": "3. Status actions",
      "item": [
        {
          "name": "Mark Brand Identity completed",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/projects/mark-completed/?project_id={{complete_project_id}}"
          }
        },
        {
          "name": "Mark SEO Audit on hold",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/projects/mark-on-hold/?project_id={{hold_project_id}}"
          }
        }
      ]
    },
    {
      "name": "4. List tabs — GET only",
      "item": [
        { "name": "List all", "request": { "method": "GET", "url": "{{base_url}}/api/projects/" } },
        { "name": "All tab", "request": { "method": "GET", "url": "{{base_url}}/api/projects/?filter=all" } },
        { "name": "Active tab", "request": { "method": "GET", "url": "{{base_url}}/api/projects/?filter=active" } },
        { "name": "Completed tab", "request": { "method": "GET", "url": "{{base_url}}/api/projects/?filter=completed" } }
      ]
    },
    {
      "name": "5. Filter by status — GET only",
      "item": [
        { "name": "All Statuses", "request": { "method": "GET", "url": "{{base_url}}/api/projects/?status=all_statuses" } },
        { "name": "ACTIVE", "request": { "method": "GET", "url": "{{base_url}}/api/projects/?status=active" } },
        { "name": "ON HOLD", "request": { "method": "GET", "url": "{{base_url}}/api/projects/?status=on_hold" } },
        { "name": "COMPLETED", "request": { "method": "GET", "url": "{{base_url}}/api/projects/?status=completed" } },
        { "name": "CANCELLED", "request": { "method": "GET", "url": "{{base_url}}/api/projects/?status=cancelled" } }
      ]
    },
    {
      "name": "6. Sort — GET only",
      "item": [
        { "name": "Created Time desc", "request": { "method": "GET", "url": "{{base_url}}/api/projects/?sort_by=created_time&sort_order=desc" } },
        { "name": "Project Name asc", "request": { "method": "GET", "url": "{{base_url}}/api/projects/?sort_by=project_name&sort_order=asc" } },
        { "name": "Customer Name asc", "request": { "method": "GET", "url": "{{base_url}}/api/projects/?sort_by=customer_name&sort_order=asc" } },
        { "name": "Rate desc", "request": { "method": "GET", "url": "{{base_url}}/api/projects/?sort_by=rate&sort_order=desc" } }
      ]
    },
    {
      "name": "7. More options",
      "item": [
        { "name": "Get one", "request": { "method": "GET", "url": "{{base_url}}/api/projects/?project_id={{project_id}}" } },
        { "name": "Refresh", "request": { "method": "POST", "url": "{{base_url}}/api/projects/refresh/" } },
        { "name": "Export JSON", "request": { "method": "GET", "url": "{{base_url}}/api/projects/export/" } },
        { "name": "Export CSV", "request": { "method": "GET", "url": "{{base_url}}/api/projects/export/?export_format=csv" } }
      ]
    }
  ]
}
