{
  "info": {
    "name": "Techgeum Sales by Item",
    "description": "Sales by Item under Reports > Sales. Run Login first. Do not leave a space after any URL. Defaults match the screenshot: This Month, ITEM NAME / SKU / QUANTITY SOLD / AMOUNT / AVERAGE PRICE.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "access_token", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "0. Login",
      "item": [
        {
          "name": "Login — saves access_token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json.access || (json.data && json.data.access);",
                  "if (token) { pm.collectionVariables.set('access_token', token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your@email.com\",\n  \"password\": \"YourPassword\"\n}"
            },
            "url": "{{base_url}}/api/accounts/login/"
          }
        }
      ]
    },
    {
      "name": "1. Sales menu",
      "item": [
        { "name": "Sales index", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/" } },
        { "name": "Sales options", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/options/" } }
      ]
    },
    {
      "name": "2. Sales by Item",
      "item": [
        { "name": "Options", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/sales-by-item/options/" } },
        { "name": "Filter form", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/sales-by-item/form/" } },
        { "name": "Export form", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/sales-by-item/export-form/" } },
        { "name": "Run this month", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/sales-by-item/?date_range=this_month" } },
        {
          "name": "Run Report POST",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date_range\": \"this_month\"\n}"
            },
            "url": "{{base_url}}/api/reports/sales/sales-by-item/run/"
          }
        },
        { "name": "Today", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/sales-by-item/?date_range=today" } },
        { "name": "This Week", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/sales-by-item/?date_range=this_week" } },
        { "name": "This Quarter", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/sales-by-item/?date_range=this_quarter" } },
        { "name": "This Year", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/sales-by-item/?date_range=this_year" } },
        { "name": "Previous Week", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/sales-by-item/?date_range=previous_week" } },
        { "name": "Previous Month", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/sales-by-item/?date_range=previous_month" } },
        { "name": "Previous Quarter", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/sales-by-item/?date_range=previous_quarter" } },
        { "name": "Previous Year", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/sales-by-item/?date_range=previous_year" } },
        { "name": "Custom dates", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/sales-by-item/?date_range=custom&date_from=2026-09-01&date_to=2026-09-30" } },
        { "name": "Export JSON", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/sales-by-item/export/?export_format=json&date_range=this_month" } },
        { "name": "Export CSV", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/sales-by-item/export/?export_format=csv" } },
        { "name": "Export PDF", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/sales-by-item/export/?export_format=pdf&export_file_name=Sales_by_Item&language=en" } },
        {
          "name": "Export PDF with layout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date_range\": \"this_month\",\n  \"export_format\": \"pdf\",\n  \"export_file_name\": \"Sales_by_Item\",\n  \"language\": \"en\",\n  \"display\": {\n    \"organization_name\": true,\n    \"organization_details\": false,\n    \"report_basis\": true,\n    \"page_number\": false,\n    \"generated_by\": false,\n    \"generated_date\": false,\n    \"generated_time\": false\n  },\n  \"column_headers_on_each_page\": true,\n  \"table_density\": \"classic\",\n  \"auto_resize_table\": true,\n  \"paper_size\": \"A4\",\n  \"orientation\": \"portrait\",\n  \"margins\": { \"top\": \"0.7\", \"bottom\": \"0.55\", \"left\": \"0.2\", \"right\": \"0.2\" }\n}"
            },
            "url": "{{base_url}}/api/reports/sales/sales-by-item/export/"
          }
        },
        { "name": "Empty organization_id — 400", "request": { "method": "GET", "url": "{{base_url}}/api/reports/sales/sales-by-item/?organization_id=" } },
        { "name": "Catalog shortcut", "request": { "method": "GET", "url": "{{base_url}}/api/reports/?report_key=sales_by_item" } }
      ]
    }
  ]
}
