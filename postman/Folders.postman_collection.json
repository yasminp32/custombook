{
  "info": {
    "name": "Techgeum Folders",
    "description": "Run in order: 0 Login → 1 Form → 2 Create. Search is GET only. File counts come from /api/files/ where folder name matches. Do not send empty folder_id or a trailing space in the URL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "access_token", "value": "" },
    { "key": "folder_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "0. Login",
      "item": [
        {
          "name": "Login — saves access_token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json.access || (json.data && json.data.access);",
                  "if (token) { pm.collectionVariables.set('access_token', token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your@email.com\",\n  \"password\": \"YourPassword\"\n}"
            },
            "url": "{{base_url}}/api/accounts/login/"
          }
        }
      ]
    },
    {
      "name": "1. Form and options",
      "item": [
        {
          "name": "Form — New Folder",
          "request": { "method": "GET", "url": "{{base_url}}/api/folders/form/" }
        },
        {
          "name": "Options",
          "request": { "method": "GET", "url": "{{base_url}}/api/folders/options/" }
        }
      ]
    },
    {
      "name": "2. Create",
      "item": [
        {
          "name": "Create Invoices",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.folder_id) {",
                  "  pm.collectionVariables.set('folder_id', json.data.folder_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Invoices\"\n}"
            },
            "url": "{{base_url}}/api/folders/"
          }
        },
        {
          "name": "Create Receipts",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Receipts\"\n}" },
            "url": "{{base_url}}/api/folders/"
          }
        },
        {
          "name": "Create Contracts",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Contracts\"\n}" },
            "url": "{{base_url}}/api/folders/"
          }
        },
        {
          "name": "Create Reports",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Reports\"\n}" },
            "url": "{{base_url}}/api/folders/"
          }
        }
      ]
    },
    {
      "name": "3. List and search",
      "item": [
        {
          "name": "List folders",
          "request": { "method": "GET", "url": "{{base_url}}/api/folders/" }
        },
        {
          "name": "Search folders",
          "request": { "method": "GET", "url": "{{base_url}}/api/folders/?search=Inv" }
        },
        {
          "name": "Get one folder",
          "request": { "method": "GET", "url": "{{base_url}}/api/folders/?folder_id={{folder_id}}" }
        },
        {
          "name": "Files in this folder",
          "request": { "method": "GET", "url": "{{base_url}}/api/files/?folder=Invoices" }
        }
      ]
    },
    {
      "name": "4. Update, errors, delete",
      "item": [
        {
          "name": "Rename folder",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Invoices\"\n}" },
            "url": "{{base_url}}/api/folders/?folder_id={{folder_id}}"
          }
        },
        {
          "name": "Duplicate name — 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Invoices\"\n}" },
            "url": "{{base_url}}/api/folders/"
          }
        },
        {
          "name": "Empty name — 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"\"\n}" },
            "url": "{{base_url}}/api/folders/"
          }
        },
        {
          "name": "Empty folder_id — 400",
          "request": { "method": "GET", "url": "{{base_url}}/api/folders/?folder_id=" }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/folders/?folder_id={{folder_id}}"
          }
        }
      ]
    }
  ]
}
