{
  "info": {
    "name": "Techgeum Time Entries",
    "description": "Run in order: 0 Login → 1 Form → 2 Create. Tabs and type filters are GET only. Create is POST /api/time-entries/ with JSON project_id and task_name. Create projects first if Form has no projects.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "access_token", "value": "" },
    { "key": "project_id", "value": "" },
    { "key": "time_entry_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "0. Login",
      "item": [
        {
          "name": "Login — saves access_token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json.access || (json.data && json.data.access);",
                  "if (token) { pm.collectionVariables.set('access_token', token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your@email.com\",\n  \"password\": \"YourPassword\"\n}"
            },
            "url": "{{base_url}}/api/accounts/login/"
          }
        }
      ]
    },
    {
      "name": "1. Form and options",
      "item": [
        {
          "name": "Form — saves project_id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json.data || {};",
                  "if (data.projects && data.projects.length) {",
                  "  pm.collectionVariables.set('project_id', data.projects[0].project_id);",
                  "}"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/form/" }
        },
        {
          "name": "Options",
          "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/options/" }
        },
        {
          "name": "Edit form — needs time_entry_id from Create",
          "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/form/?time_entry_id={{time_entry_id}}" }
        }
      ]
    },
    {
      "name": "2. Create",
      "item": [
        {
          "name": "Homepage layout — 2h 30m BILLABLE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.time_entry_id) {",
                  "  pm.collectionVariables.set('time_entry_id', json.data.time_entry_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"task_name\": \"Homepage layout\",\n  \"log_date\": \"2026-07-03\",\n  \"hours\": 2,\n  \"minutes\": 30,\n  \"type\": \"billable\"\n}"
            },
            "url": "{{base_url}}/api/time-entries/"
          }
        },
        {
          "name": "API integration — 5h 20m BILLABLE",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"task_name\": \"API integration\",\n  \"log_date\": \"2026-07-02\",\n  \"hours\": 5,\n  \"minutes\": 20,\n  \"type\": \"billable\"\n}"
            },
            "url": "{{base_url}}/api/time-entries/"
          }
        },
        {
          "name": "Internal review — 0h 45m NON-BILLABLE",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"task_name\": \"Internal review\",\n  \"log_date\": \"2026-06-30\",\n  \"hours\": 0,\n  \"minutes\": 45,\n  \"type\": \"non_billable\"\n}"
            },
            "url": "{{base_url}}/api/time-entries/"
          }
        },
        {
          "name": "Keyword research — 1h 30m NON-BILLABLE",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"task_name\": \"Keyword research\",\n  \"log_date\": \"2026-06-28\",\n  \"hours\": 1,\n  \"minutes\": 30,\n  \"type\": \"non_billable\"\n}"
            },
            "url": "{{base_url}}/api/time-entries/"
          }
        }
      ]
    },
    {
      "name": "3. List tabs — GET only",
      "item": [
        { "name": "List all", "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/" } },
        { "name": "All tab", "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/?filter=all" } },
        { "name": "Billable tab", "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/?filter=billable" } },
        { "name": "Non-billable tab", "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/?filter=non_billable" } }
      ]
    },
    {
      "name": "4. Filter by type — GET only",
      "item": [
        { "name": "All Entries", "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/?type=all_entries" } },
        { "name": "BILLABLE", "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/?type=billable" } },
        { "name": "NON-BILLABLE", "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/?type=non_billable" } }
      ]
    },
    {
      "name": "5. Sort and search — GET only",
      "item": [
        { "name": "Sort Created Time desc", "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/?sort_by=created_time&sort_order=desc" } },
        { "name": "Sort Date desc", "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/?sort_by=date&sort_order=desc" } },
        { "name": "Sort Project Name asc", "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/?sort_by=project_name&sort_order=asc" } },
        { "name": "Sort Duration desc", "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/?sort_by=duration&sort_order=desc" } },
        { "name": "Search task Homepage", "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/?search=Homepage" } },
        { "name": "Search project", "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/?search=Website" } }
      ]
    },
    {
      "name": "6. Get, update, export",
      "item": [
        { "name": "Get one", "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/?time_entry_id={{time_entry_id}}" } },
        {
          "name": "PATCH notes",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"notes\": \"Updated notes\"\n}" },
            "url": "{{base_url}}/api/time-entries/?time_entry_id={{time_entry_id}}"
          }
        },
        {
          "name": "PUT full update",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"task_name\": \"Homepage layout\",\n  \"log_date\": \"2026-07-03\",\n  \"hours\": 2,\n  \"minutes\": 30,\n  \"type\": \"billable\",\n  \"notes\": \"Full update\"\n}"
            },
            "url": "{{base_url}}/api/time-entries/?time_entry_id={{time_entry_id}}"
          }
        },
        { "name": "Refresh", "request": { "method": "POST", "url": "{{base_url}}/api/time-entries/refresh/" } },
        { "name": "Refresh Billable tab", "request": { "method": "POST", "url": "{{base_url}}/api/time-entries/refresh/?filter=billable" } },
        { "name": "Export JSON", "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/export/" } },
        { "name": "Export CSV", "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/export/?export_format=csv" } }
      ]
    },
    {
      "name": "7. Error cases — expected to fail",
      "item": [
        {
          "name": "Create without project — 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_name\": \"Missing project\",\n  \"hours\": 1,\n  \"minutes\": 0\n}"
            },
            "url": "{{base_url}}/api/time-entries/"
          }
        },
        {
          "name": "Create without task name — 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"hours\": 1,\n  \"minutes\": 0\n}"
            },
            "url": "{{base_url}}/api/time-entries/"
          }
        },
        {
          "name": "Create minutes 60 — 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"task_name\": \"Bad minutes\",\n  \"hours\": 1,\n  \"minutes\": 60\n}"
            },
            "url": "{{base_url}}/api/time-entries/"
          }
        },
        {
          "name": "GET unknown id — 404",
          "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/?time_entry_id=00000000-0000-0000-0000-000000000000" }
        },
        {
          "name": "GET invalid sort_by — 400",
          "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/?sort_by=foo" }
        },
        {
          "name": "POST list filter URL — this is CREATE not list",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/time-entries/?filter=billable"
          }
        }
      ]
    },
    {
      "name": "8. Delete — run last",
      "item": [
        {
          "name": "Delete one",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/time-entries/?time_entry_id={{time_entry_id}}"
          }
        },
        {
          "name": "Get deleted — 404",
          "request": { "method": "GET", "url": "{{base_url}}/api/time-entries/?time_entry_id={{time_entry_id}}" }
        }
      ]
    }
  ]
}
