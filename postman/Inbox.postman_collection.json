{
  "info": {
    "name": "Techgeum Inbox",
    "description": "Run in order: 0 Login → 1 Form → 2 Upload (form-data file). List/sort/search are GET only. Download and Share need document_id. Do not leave a space after the URL or send empty document_id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "access_token", "value": "" },
    { "key": "document_id", "value": "" },
    { "key": "share_token", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "0. Login",
      "item": [
        {
          "name": "Login — saves access_token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json.access || (json.data && json.data.access);",
                  "if (token) { pm.collectionVariables.set('access_token', token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your@email.com\",\n  \"password\": \"YourPassword\"\n}"
            },
            "url": "{{base_url}}/api/accounts/login/"
          }
        }
      ]
    },
    {
      "name": "1. Form and options",
      "item": [
        {
          "name": "Form — Upload Document",
          "request": { "method": "GET", "url": "{{base_url}}/api/inbox/form/" }
        },
        {
          "name": "Options — sort and actions",
          "request": { "method": "GET", "url": "{{base_url}}/api/inbox/options/" }
        },
        {
          "name": "Document detail form",
          "request": { "method": "GET", "url": "{{base_url}}/api/inbox/form/?document_id={{document_id}}" }
        }
      ]
    },
    {
      "name": "2. Upload",
      "item": [
        {
          "name": "Upload file — form-data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.document_id) {",
                  "  pm.collectionVariables.set('document_id', json.data.document_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                { "key": "folder", "type": "text", "value": "Inbox" }
              ]
            },
            "url": "{{base_url}}/api/inbox/"
          }
        }
      ]
    },
    {
      "name": "3. List, search, sort",
      "item": [
        {
          "name": "List Recently received",
          "request": { "method": "GET", "url": "{{base_url}}/api/inbox/" }
        },
        {
          "name": "Search Invoice",
          "request": { "method": "GET", "url": "{{base_url}}/api/inbox/?search=Invoice" }
        },
        {
          "name": "Sort Uploaded Time descending",
          "request": { "method": "GET", "url": "{{base_url}}/api/inbox/?sort_by=uploaded_time&sort_order=desc" }
        },
        {
          "name": "Sort Name ascending",
          "request": { "method": "GET", "url": "{{base_url}}/api/inbox/?sort_by=name&sort_order=asc" }
        },
        {
          "name": "Sort Size descending",
          "request": { "method": "GET", "url": "{{base_url}}/api/inbox/?sort_by=size&sort_order=desc" }
        },
        {
          "name": "Get one document",
          "request": { "method": "GET", "url": "{{base_url}}/api/inbox/?document_id={{document_id}}" }
        }
      ]
    },
    {
      "name": "4. Download, share, refresh",
      "item": [
        {
          "name": "Download",
          "request": { "method": "GET", "url": "{{base_url}}/api/inbox/download/?document_id={{document_id}}" }
        },
        {
          "name": "Share",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.share_token) {",
                  "  pm.collectionVariables.set('share_token', json.data.share_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{base_url}}/api/inbox/share/?document_id={{document_id}}"
          }
        },
        {
          "name": "Open shared link",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/api/inbox/shared/{{share_token}}/"
          }
        },
        {
          "name": "Download shared file",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/api/inbox/shared/{{share_token}}/download/"
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{base_url}}/api/inbox/refresh/"
          }
        }
      ]
    },
    {
      "name": "5. Errors and delete",
      "item": [
        {
          "name": "Empty document_id — 400",
          "request": { "method": "GET", "url": "{{base_url}}/api/inbox/?document_id=" }
        },
        {
          "name": "Upload without file — 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{base_url}}/api/inbox/"
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/inbox/?document_id={{document_id}}"
          }
        }
      ]
    }
  ]
}
