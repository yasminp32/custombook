{
  "info": {
    "name": "Techgeum Manual Journals",
    "description": "Run in order: 0 Login → 1 Form → 2 Create. Tabs and status filters are GET only. Create is POST /api/manual-journals/ with action save_as_draft or save_as_published. Do not leave a space after the URL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "access_token", "value": "" },
    { "key": "journal_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "0. Login",
      "item": [
        {
          "name": "Login — saves access_token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json.access || (json.data && json.data.access);",
                  "if (token) { pm.collectionVariables.set('access_token', token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your@email.com\",\n  \"password\": \"YourPassword\"\n}"
            },
            "url": "{{base_url}}/api/accounts/login/"
          }
        }
      ]
    },
    {
      "name": "1. Form and options",
      "item": [
        {
          "name": "Form — New Manual Journal",
          "request": { "method": "GET", "url": "{{base_url}}/api/manual-journals/form/" }
        },
        {
          "name": "Options — tabs, status, sort",
          "request": { "method": "GET", "url": "{{base_url}}/api/manual-journals/options/" }
        },
        {
          "name": "Edit form — needs journal_id",
          "request": { "method": "GET", "url": "{{base_url}}/api/manual-journals/form/?journal_id={{journal_id}}" }
        }
      ]
    },
    {
      "name": "2. Create",
      "item": [
        {
          "name": "Save as Published — MJ-00012 REF-101",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.journal_id) {",
                  "  pm.collectionVariables.set('journal_id', json.data.journal_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"journal_number\": \"MJ-00012\",\n  \"reference_number\": \"REF-101\",\n  \"journal_date\": \"2026-07-03\",\n  \"amount\": \"4500.00\",\n  \"notes\": \"\",\n  \"action\": \"save_as_published\"\n}"
            },
            "url": "{{base_url}}/api/manual-journals/"
          }
        },
        {
          "name": "Save as Draft — MJ-00011 REF-098",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"journal_number\": \"MJ-00011\",\n  \"reference_number\": \"REF-098\",\n  \"journal_date\": \"2026-07-02\",\n  \"amount\": \"1250.00\",\n  \"action\": \"save_as_draft\"\n}"
            },
            "url": "{{base_url}}/api/manual-journals/"
          }
        },
        {
          "name": "Save as Published — MJ-00010 REF-090",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"journal_number\": \"MJ-00010\",\n  \"reference_number\": \"REF-090\",\n  \"journal_date\": \"2026-06-30\",\n  \"amount\": \"3200.00\",\n  \"action\": \"save_as_published\"\n}"
            },
            "url": "{{base_url}}/api/manual-journals/"
          }
        },
        {
          "name": "Save as Draft — MJ-00009 no reference",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"journal_number\": \"MJ-00009\",\n  \"journal_date\": \"2026-06-28\",\n  \"amount\": \"75.00\",\n  \"action\": \"save_as_draft\"\n}"
            },
            "url": "{{base_url}}/api/manual-journals/"
          }
        }
      ]
    },
    {
      "name": "3. List tabs, filter, sort, search",
      "item": [
        {
          "name": "All",
          "request": { "method": "GET", "url": "{{base_url}}/api/manual-journals/?filter=all" }
        },
        {
          "name": "Draft tab",
          "request": { "method": "GET", "url": "{{base_url}}/api/manual-journals/?filter=draft" }
        },
        {
          "name": "Published tab",
          "request": { "method": "GET", "url": "{{base_url}}/api/manual-journals/?filter=published" }
        },
        {
          "name": "Filter All Statuses",
          "request": { "method": "GET", "url": "{{base_url}}/api/manual-journals/?status=all_statuses" }
        },
        {
          "name": "Filter DRAFT",
          "request": { "method": "GET", "url": "{{base_url}}/api/manual-journals/?status=draft" }
        },
        {
          "name": "Filter PUBLISHED",
          "request": { "method": "GET", "url": "{{base_url}}/api/manual-journals/?status=published" }
        },
        {
          "name": "Sort Created Time descending",
          "request": { "method": "GET", "url": "{{base_url}}/api/manual-journals/?sort_by=created_time&sort_order=desc" }
        },
        {
          "name": "Sort Date ascending",
          "request": { "method": "GET", "url": "{{base_url}}/api/manual-journals/?sort_by=date&sort_order=asc" }
        },
        {
          "name": "Sort Journal# descending",
          "request": { "method": "GET", "url": "{{base_url}}/api/manual-journals/?sort_by=journal_number&sort_order=desc" }
        },
        {
          "name": "Sort Amount descending",
          "request": { "method": "GET", "url": "{{base_url}}/api/manual-journals/?sort_by=amount&sort_order=desc" }
        },
        {
          "name": "Search REF-101",
          "request": { "method": "GET", "url": "{{base_url}}/api/manual-journals/?search=REF-101" }
        },
        {
          "name": "Get one by journal_id",
          "request": { "method": "GET", "url": "{{base_url}}/api/manual-journals/?journal_id={{journal_id}}" }
        }
      ]
    },
    {
      "name": "4. Update, publish, export, refresh",
      "item": [
        {
          "name": "PUT update — needs draft journal_id",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference_number\": \"REF-098\",\n  \"amount\": \"1250.00\",\n  \"notes\": \"Updated draft\",\n  \"action\": \"save_as_draft\"\n}"
            },
            "url": "{{base_url}}/api/manual-journals/?journal_id={{journal_id}}"
          }
        },
        {
          "name": "Publish draft",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{base_url}}/api/manual-journals/publish/?journal_id={{journal_id}}"
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{base_url}}/api/manual-journals/refresh/?filter=all"
          }
        },
        {
          "name": "Export JSON",
          "request": { "method": "GET", "url": "{{base_url}}/api/manual-journals/export/" }
        },
        {
          "name": "Export CSV",
          "request": { "method": "GET", "url": "{{base_url}}/api/manual-journals/export/?export_format=csv" }
        }
      ]
    },
    {
      "name": "5. Errors and delete",
      "item": [
        {
          "name": "Negative amount — 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"-10\",\n  \"action\": \"save_as_draft\"\n}"
            },
            "url": "{{base_url}}/api/manual-journals/"
          }
        },
        {
          "name": "Delete published — 400",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/manual-journals/?journal_id={{journal_id}}"
          }
        },
        {
          "name": "Delete draft — 200",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/manual-journals/?journal_id={{journal_id}}"
          }
        }
      ]
    }
  ]
}
